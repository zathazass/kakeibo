# Dependency directories — reinstallable from the lockfiles, never committed.
node_modules/
env/
.venv/
venv/

# Build output — regenerated by `npm run build`.
frontend/build/
frontend/.cache/
.vite/

# Python bytecode.
__pycache__/
*.py[cod]

# SQLite runtime scratch. The ledger itself (backend/kakeibo.db) IS tracked so
# your data is version-controlled; these two are transient files SQLite rebuilds
# on its own. Stop the API before committing, so the WAL is checkpointed into
# the .db and the commit holds every entry.
*.db-wal
*.db-shm
