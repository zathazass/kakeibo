# Copy to .env (or just export these) — every value is optional.
# Where the SQLite file lives. Default: backend/kakeibo.db
KAKEIBO_DB=./kakeibo.db
# Currency symbol shown across the UI.
KAKEIBO_CURRENCY=₹
# Number formatting locale used by the frontend (e.g. en-IN, en-US, ja-JP).
KAKEIBO_LOCALE=en-IN
# Dev origins allowed to call the API (the Remix dev server on port 2455).
KAKEIBO_CORS_ORIGINS=http://localhost:2455,http://127.0.0.1:2455
# Built Remix SPA to serve from FastAPI. Default: frontend/build/client
KAKEIBO_FRONTEND_DIST=../frontend/build/client
